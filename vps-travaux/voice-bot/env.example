# ============================================================================
#  Bot vocal Hermès — configuration.
#  Copie ce fichier en `.env`  (cp env.example .env)  puis adapte-le.
#  Seul TELEGRAM_BOT_TOKEN est obligatoire ; tout le reste a un défaut sain.
# ============================================================================

# --- Telegram ----------------------------------------------------------------
# Token fourni par @BotFather (format 123456789:ABC-...).
TELEGRAM_BOT_TOKEN=

# Liste blanche des IDs Telegram autorisés (séparés par des virgules).
# ⚠️ FORTEMENT recommandé : sinon le bot répond à n'importe qui.
# Pour connaître ton ID : écris /start au bot, il te le renvoie.
ALLOWED_USER_IDS=

# Renvoyer la transcription pour relecture ("J'ai compris : …"). true/false
SEND_TRANSCRIPT=true
# Joindre aussi le texte de la réponse d'Hermès (en plus du vocal). true/false
REPLY_WITH_TEXT=true

# --- STT : transcription locale (Speaches / faster-whisper) ------------------
# URL du service STT compatible OpenAI. En Docker co-hébergé : http://speaches:8000
STT_BASE_URL=http://speaches:8000
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
STT_LANGUAGE=fr
STT_API_KEY=
STT_TIMEOUT=120
# Filtre les silences (recommandé pour Speaches). Mets false pour Groq/OpenAI.
STT_VAD_FILTER=true

# --- Secours cloud (optionnel, NON local) ------------------------------------
# Pour basculer sur Groq si le VPS sature : décommente et renseigne.
# STT_BASE_URL=https://api.groq.com/openai
# STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=gsk_xxx
# STT_VAD_FILTER=false

# --- TTS : synthèse vocale ---------------------------------------------------
# Backend : speaches | piper | none
TTS_BACKEND=speaches
# Par défaut : même service que le STT (Speaches expose aussi /v1/audio/speech).
# TTS_BASE_URL=http://speaches:8000
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=ff_siwis
TTS_API_KEY=
TTS_SPEED=1.0
TTS_TIMEOUT=120
# Si Hermès dépose lui-même un audio dans out/, le réutiliser plutôt que re-synthétiser.
PREFER_OUT_AUDIO=true
# Pour TTS_BACKEND=piper uniquement :
# PIPER_BIN=piper
# PIPER_MODEL=/opt/data/piper-voices/fr/fr_FR-upmc-medium.onnx

# --- Aiguilleur (file partagée avec Hermès) ----------------------------------
QUEUE_IN=/opt/data/claude-queue/in
QUEUE_OUT=/opt/data/claude-queue/out
# Où déplacer les réponses traitées. Vide = les supprimer après lecture.
QUEUE_ARCHIVE=/opt/data/claude-queue/out/.processed
# Cadence de relecture de out/ (s) et délai max d'attente d'une réponse (s).
OUT_POLL_INTERVAL=1.0
OUT_TIMEOUT=180
# Délai d'immobilité d'un fichier out/ avant lecture (anti-lecture partielle).
OUT_QUIESCE=0.5

# --- RGPD / exploitation -----------------------------------------------------
AUDIO_TMP_DIR=/tmp/hermes-voice-bot
# Conserver les audios ? false = purge après usage (recommandé, RGPD).
KEEP_AUDIO=false

# --- Healthcheck (Uptime Kuma) ----------------------------------------------
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# Faire échouer /health si le STT est injoignable ? (false = simple report)
HEALTH_REQUIRE_STT=false

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=INFO
