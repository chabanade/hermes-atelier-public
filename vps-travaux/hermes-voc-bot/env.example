# --- Hermes Voc Bot — modèle de configuration ---
# Copier en .env puis adapter :  cp env.example .env

# Token du bot Telegram (BotFather).
#   • En clair via .env :
TELEGRAM_TOKEN=<SECRET_REDACTED>
#   • OU encodé en base64, exporté au lancement (prioritaire sur TELEGRAM_TOKEN) :
#       BOT_TOKEN_B64=$(printf '%s' "$TELEGRAM_TOKEN" | base64 -w0)  python bot.py

# URL de Speaches.
#   • Déploiement VPS / Docker (bot dans le même réseau Docker) :
#       SPEACHES_URL=http://speaches:8000
#   • Bot lancé sur l'hôte, port 8000 publié :
#       SPEACHES_URL=http://localhost:8000
SPEACHES_URL=http://speaches:8000

# Modèle chargé par Speaches (à vérifier avec : curl $SPEACHES_URL/v1/models).
# Ce n'est PAS "speaches" (= nom du serveur) mais l'identifiant du modèle whisper.
SPEACHES_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
LANGUAGE=fr

# Archivage des transcriptions.
#   • Sur le VPS Hermès : /opt/data/hermes-voc-bot/transcripts
#   • Défaut si absent : ./transcripts (à côté de bot.py)
TRANSCRIPTS_DIR=/opt/data/hermes-voc-bot/transcripts

# Inbox Hermès : un JSON « pending » par vocal transcrit, lu par l'assistant.
#   • Sur le VPS Hermès : /opt/data/hermes-voc-bot/inbox
#   • Défaut si absent : ./inbox (à côté de bot.py)
INBOX_DIR=/opt/data/hermes-voc-bot/inbox

# Endpoint HTTP où Hermès POSTe ses réponses (POST /reply, GET /health).
# Garder 127.0.0.1 sauf si Hermès est sur une autre machine : /reply peut
# envoyer un message arbitraire à n'importe quel chat → exposer = renseigner
# REPLY_AUTH_TOKEN et placer derrière un reverse-proxy/pare-feu.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
REPLY_AUTH_TOKEN=

REQUEST_TIMEOUT=180

# Chat destinataire du ping « Bot vocal prêt ✅ » au démarrage (facultatif).
READY_CHAT_ID=
