# =============================================================================
# notify.env — config du relais de notification (copier en notify.env).
# =============================================================================
# Toutes les clés sont FACULTATIVES : si tu ne mets rien, le relais réutilise
# automatiquement READY_CHAT_ID et TELEGRAM_TOKEN de hermes-voc-bot/.env.
# Le SEUL paramètre vraiment utile à renseigner est le destinataire ci-dessous.

# Destinataire Telegram du message « ouvrier a fini » (ton chat_id, ou @canal).
# Laisser vide => repli sur READY_CHAT_ID de hermes-voc-bot/.env.
NOTIFY_CHAT_ID=

# Endpoint qui envoie réellement le message (le /reply EXISTANT du bot).
HERMES_REPLY_URL=http://127.0.0.1:8080/reply

# Si /reply exige un jeton partagé (REPLY_AUTH_TOKEN côté bot), le remettre ici.
REPLY_AUTH_TOKEN=

# Repli direct si /reply est injoignable. Laisser vide => repris de
# hermes-voc-bot/.env (TELEGRAM_TOKEN).
TELEGRAM_TOKEN=

# Fichier signal écrit par l'ouvrier (à ne changer que si tu déplaces l'atelier).
OUVRIER_DONE_FILE=/home/ouvrier/travaux/.done

# Divers (défauts sains).
NOTIFY_HTTP_TIMEOUT=15
NOTIFY_ARCHIVE_DIR=/home/ouvrier/journal/done-archive
NOTIFY_LOG_FILE=/home/ouvrier/journal/ouvrier-notify.log
HERMES_ENV_FALLBACK=/home/ouvrier/travaux/hermes-voc-bot/.env
